From cace52fd59b0a3092c1371e2b0e0f7c9aaf0787b Mon Sep 17 00:00:00 2001
From: PrismML <noreply@prismml.ai>
Date: Tue, 27 Oct 2026 12:35:47 -0400
Subject: [PATCH] Prism: HERMES_EMPTY_RECOVERY=resample (no stacked assistant
 messages on empty replies)

An empty reply (finish_reason=stop, no content, no tool call) is never appended:
the same request is re-sampled up to HERMES_EMPTY_RESAMPLES (2) times, then one
truncation-style user nudge (HERMES_EMPTY_NUDGES, 1), then the stock terminal exit
(no "(empty)" post-tool nudge, no _thinking_prefill). Events go to
HERMES_EMPTY_RECOVERY_LOG. Unset = stock behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 agent/conversation_loop.py                   |  79 +++++++++++++
 agent/turn_context.py                        |   2 +
 tests/run_agent/test_prism_empty_recovery.py | 110 +++++++++++++++++++
 3 files changed, 191 insertions(+)
 create mode 100644 tests/run_agent/test_prism_empty_recovery.py

diff --git a/agent/conversation_loop.py b/agent/conversation_loop.py
index 420d126..9198909 100644
--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -426,6 +426,48 @@ def _stored_prompt_matches_runtime(agent, prompt: str) -> bool:
     return True
 
 
+# ── Prism empty-response recovery (HERMES_EMPTY_RECOVERY=resample) ──────────
+# Stock Hermes answers an empty reply (finish_reason=stop, no content, no tool
+# call) with a post-tool "(empty)" assistant + user nudge and then up to two
+# reasoning-only `_thinking_prefill` assistant messages, i.e. two trailing
+# assistant messages (llama.cpp rejects that with HTTP 400) and synthetic
+# assistant turns in the transcript. With HERMES_EMPTY_RECOVERY=resample the
+# empty reply is never appended: the same request is re-sampled up to
+# HERMES_EMPTY_RESAMPLES times (default 2), then one user nudge in the style of
+# the truncation continuation is appended (HERMES_EMPTY_NUDGES, default 1),
+# then the stock terminal "(empty)" exit. Every event is appended to
+# HERMES_EMPTY_RECOVERY_LOG (JSONL) when set. Unset = stock behaviour.
+EMPTY_RECOVERY_NUDGE = (
+    "[System: Your previous response ended without a reply or a tool call. "
+    "Continue with the task now: take the next action with your tools, or "
+    "give your final answer.]"
+)
+
+
+def _empty_recovery_mode() -> str:
+    return os.environ.get("HERMES_EMPTY_RECOVERY", "").strip().lower()
+
+
+def _empty_recovery_log(agent, kind: str, **fields) -> None:
+    path = os.environ.get("HERMES_EMPTY_RECOVERY_LOG")
+    if not path:
+        return
+    try:
+        rec = {"ts": time.time(), "kind": kind,
+               "resamples": getattr(agent, "_empty_recovery_resamples", 0),
+               "nudges": getattr(agent, "_empty_recovery_nudges", 0)}
+        rec.update(fields)
+        with open(path, "a", encoding="utf-8") as f:
+            f.write(json.dumps(rec) + "\n")
+    except Exception:
+        logger.debug("empty-recovery log write failed", exc_info=True)
+
+
+def _reset_empty_recovery(agent) -> None:
+    agent._empty_recovery_resamples = 0
+    agent._empty_recovery_nudges = 0
+
+
 def _get_continuation_prompt(is_partial_stub: bool, dropped_tools: Optional[List[str]] = None) -> str:
     if is_partial_stub and dropped_tools:
         tool_list = ", ".join(dropped_tools[:3])
@@ -4843,6 +4885,7 @@ def run_conversation(
                 # flag so it can fire again if the model goes empty on
                 # a LATER tool round.
                 agent._post_tool_empty_retried = False
+                _reset_empty_recovery(agent)
 
                 messages.append(assistant_msg)
                 agent._emit_interim_assistant_message(assistant_msg)
@@ -5011,6 +5054,41 @@ def run_conversation(
                         agent._response_was_previewed = False
                         break
 
+                    # ── Prism empty-response recovery (see EMPTY_RECOVERY_NUDGE) ──
+                    if _empty_recovery_mode() == "resample":
+                        _er_reasoning = agent._extract_reasoning(assistant_message) or ""
+                        _er_fields = {"finish_reason": finish_reason, "reasoning_chars": len(_er_reasoning),
+                                      "content_chars": len(final_response or ""), "api_call_count": api_call_count}
+                        # never leave scaffolding from an earlier recovery at the tail
+                        while (
+                            messages
+                            and isinstance(messages[-1], dict)
+                            and messages[-1].get("role") == "assistant"
+                            and (messages[-1].get("_thinking_prefill") or messages[-1].get("_empty_recovery_synthetic"))
+                        ):
+                            messages.pop()
+                        _er_rs = getattr(agent, "_empty_recovery_resamples", 0)
+                        _er_ng = getattr(agent, "_empty_recovery_nudges", 0)
+                        if _er_rs < int(os.environ.get("HERMES_EMPTY_RESAMPLES", "2")):
+                            agent._empty_recovery_resamples = _er_rs + 1
+                            _empty_recovery_log(agent, "resample", **_er_fields)
+                            agent._buffer_status(f"↻ Empty response — resampling ({_er_rs + 1})")
+                            agent._session_messages = messages
+                            continue
+                        if _er_ng < int(os.environ.get("HERMES_EMPTY_NUDGES", "1")):
+                            agent._empty_recovery_nudges = _er_ng + 1
+                            _empty_recovery_log(agent, "nudge", **_er_fields)
+                            agent._buffer_status("↻ Empty response — nudging to continue")
+                            messages.append({"role": "user", "content": EMPTY_RECOVERY_NUDGE})
+                            agent._session_messages = messages
+                            continue
+                        _empty_recovery_log(agent, "exhausted", **_er_fields)
+                        # straight to the stock terminal exit: no "(empty)" post-tool nudge, no prefill, no retries
+                        agent._post_tool_empty_retried = True
+                        agent._thinking_prefill_retries = 2
+                        agent._empty_content_retries = 3
+                        agent._last_content_with_tools = None
+
                     # If the previous turn already delivered real content alongside
                     # HOUSEKEEPING tool calls (e.g. "You're welcome!" + memory save),
                     # the model has nothing more to say. Use the earlier content
@@ -5249,6 +5327,7 @@ def run_conversation(
                 # Reset retry counter/signature on successful content
                 agent._empty_content_retries = 0
                 agent._thinking_prefill_retries = 0
+                _reset_empty_recovery(agent)
                 # Successful content reached — surface the one-shot fallback
                 # switch notice (if a fallback activated this turn) before
                 # dropping the noisy retry buffer, so a provider/model switch
diff --git a/agent/turn_context.py b/agent/turn_context.py
index 75c41a8..407bf92 100644
--- a/agent/turn_context.py
+++ b/agent/turn_context.py
@@ -232,6 +232,8 @@ def build_turn_context(
     agent._codex_incomplete_retries = 0
     agent._thinking_prefill_retries = 0
     agent._post_tool_empty_retried = False
+    agent._empty_recovery_resamples = 0
+    agent._empty_recovery_nudges = 0
     agent._last_content_with_tools = None
     agent._last_content_tools_all_housekeeping = False
     agent._mute_post_response = False
diff --git a/tests/run_agent/test_prism_empty_recovery.py b/tests/run_agent/test_prism_empty_recovery.py
new file mode 100644
index 0000000..9b35627
--- /dev/null
+++ b/tests/run_agent/test_prism_empty_recovery.py
@@ -0,0 +1,110 @@
+"""Prism patch: HERMES_EMPTY_RECOVERY=resample replaces the stacked `_thinking_prefill` / "(empty)" recovery.
+
+The failure it fixes (gamegen collection + demos, 2026-10-25..27): after a tool result the model emits a
+reasoning-only reply (llama.cpp forced </think> then EOS, or a gate_serve empty answer). Stock Hermes appends an
+"(empty)" assistant + user nudge and then reasoning-only prefill assistant messages -> two trailing assistant
+messages -> llama.cpp HTTP 400, and synthetic assistant turns in the trajectory.
+"""
+import json
+from unittest.mock import patch
+
+import pytest
+
+from agent.conversation_loop import EMPTY_RECOVERY_NUDGE
+from tests.run_agent.test_run_agent import _mock_response, _mock_tool_call, agent  # noqa: F401  (fixture)
+
+
+def _setup(agent, monkeypatch, tmp_path, **env):
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.tool_delay = 0
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    monkeypatch.setenv("HERMES_EMPTY_RECOVERY", "resample")
+    monkeypatch.setenv("HERMES_EMPTY_RECOVERY_LOG", str(tmp_path / "empty_recovery.jsonl"))
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+
+
+def _run(agent, responses, prompt="build the game"):
+    agent.client.chat.completions.create.side_effect = responses
+    with (
+        patch("run_agent.handle_function_call", return_value="ok: file written"),
+        patch.object(agent, "_persist_session"),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        result = agent.run_conversation(prompt)
+    sent = [c.kwargs["messages"] for c in agent.client.chat.completions.create.call_args_list]
+    return result, sent
+
+
+def _no_consecutive_assistant(msgs):
+    roles = [m.get("role") for m in msgs]
+    return not any(a == b == "assistant" for a, b in zip(roles, roles[1:]))
+
+
+def _tool_then(*rest):
+    tc = _mock_tool_call(name="web_search", arguments="{}", call_id="c1")
+    return [_mock_response(content="", finish_reason="tool_calls", tool_calls=[tc])] + list(rest)
+
+
+EMPTY = dict(content="", finish_reason="stop", reasoning_content="long thinking that ran into the budget")
+
+
+def test_empty_after_tool_is_resampled_not_appended(agent, monkeypatch, tmp_path):
+    _setup(agent, monkeypatch, tmp_path)
+    result, sent = _run(agent, _tool_then(_mock_response(**EMPTY), _mock_response(content="Done.", finish_reason="stop")))
+    assert result["final_response"] == "Done."
+    assert len(sent) == 3
+    assert sent[2] == sent[1]  # the resample is the identical request: nothing appended
+    assert all(_no_consecutive_assistant(m) for m in sent)
+    assert not any(m.get("content") == "(empty)" for m in result["messages"])
+    assert not any(m.get("_thinking_prefill") for m in result["messages"])
+    log = [json.loads(l) for l in open(tmp_path / "empty_recovery.jsonl")]
+    assert [r["kind"] for r in log] == ["resample"] and log[0]["reasoning_chars"] > 0
+
+
+def test_resample_twice_then_nudge_then_success(agent, monkeypatch, tmp_path):
+    _setup(agent, monkeypatch, tmp_path)
+    result, sent = _run(agent, _tool_then(*[_mock_response(**EMPTY)] * 3, _mock_response(content="Done.", finish_reason="stop")))
+    assert result["final_response"] == "Done."
+    assert len(sent) == 5 and sent[1] == sent[2] == sent[3]
+    assert sent[4][:-1] == sent[3] and sent[4][-1] == {"role": "user", "content": EMPTY_RECOVERY_NUDGE}
+    assert all(_no_consecutive_assistant(m) for m in sent)
+    # the nudge stays in the transcript (it was part of the context the model answered)
+    assert any(m.get("content") == EMPTY_RECOVERY_NUDGE for m in result["messages"])
+    assert [json.loads(l)["kind"] for l in open(tmp_path / "empty_recovery.jsonl")] == ["resample", "resample", "nudge"]
+
+
+def test_exhausted_goes_to_terminal_without_prefill(agent, monkeypatch, tmp_path):
+    _setup(agent, monkeypatch, tmp_path)
+    result, sent = _run(agent, _tool_then(*[_mock_response(**EMPTY)] * 4))
+    assert len(sent) == 5  # tool turn + original + 2 resamples + 1 nudge; nothing after exhaustion
+    assert result["turn_exit_reason"] == "empty_response_exhausted"
+    assert all(_no_consecutive_assistant(m) for m in sent)
+    assert [json.loads(l)["kind"] for l in open(tmp_path / "empty_recovery.jsonl")][-1] == "exhausted"
+
+
+def test_counters_reset_after_success(agent, monkeypatch, tmp_path):
+    _setup(agent, monkeypatch, tmp_path, HERMES_EMPTY_NUDGES="0")
+    tc2 = _mock_tool_call(name="web_search", arguments="{}", call_id="c2")
+    seq = _tool_then(
+        *[_mock_response(**EMPTY)] * 2,
+        _mock_response(content="", finish_reason="tool_calls", tool_calls=[tc2]),  # success resets the budget
+        *[_mock_response(**EMPTY)] * 2,
+        _mock_response(content="Done.", finish_reason="stop"),
+    )
+    result, sent = _run(agent, seq)
+    assert result["final_response"] == "Done."
+
+
+def test_unset_keeps_stock_behaviour(agent, monkeypatch, tmp_path):
+    monkeypatch.delenv("HERMES_EMPTY_RECOVERY", raising=False)
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.tool_delay = 0
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    result, sent = _run(agent, _tool_then(_mock_response(**EMPTY), _mock_response(content="Done.", finish_reason="stop")))
+    assert sent[2] != sent[1]  # stock: "(empty)" assistant + user nudge appended
-- 
