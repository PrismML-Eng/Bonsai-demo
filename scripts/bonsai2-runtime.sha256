# SHA-256 of the executable loader the Bonsai 2 MLX pack ships in runtime/.
#
# scripts/mlx_generate_bonsai2.py imports that code, so a change to it is a change
# to what runs on the user's machine. These hashes are the reviewed revision: the
# generator refuses to import anything that does not match.
#
# Re-pin after a deliberate runtime/ change, from the demo root:
#   shasum -a 256 models/Ternary-Bonsai-2-27B-mlx-2bit/runtime/*.py
# and replace the lines below, keeping paths relative to runtime/.
5279718d7671bd799e866f53099e82b0260117fec811f83011ba47a0abc7943e  artifact.py
7f7fd67637a7d9363eab8ebf7db59771830b690330ffef772379a0169ddb9608  codec.py
30ad3905775040a8167360a009168b9ede1436cb02dc43e9e743432482eafbbf  runtime.py
624e78d1fc7a0ddbaa637121ee823209c525b8e89f35fbc68d6d2f3f3fcfd87d  vision_artifact.py
